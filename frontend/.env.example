# Base URL of the GIC FastAPI backend (REST + WebSockets).
# The frontend derives the WebSocket URL (ws://, wss://) from this value.
# Leave as localhost for local dev; set to your hosted backend URL on Vercel.
# If unset or unreachable, the app still runs with a client-side realtime
# simulator and mock data.
REACT_APP_API_URL=http://localhost:8000
